Carribean       -85 -58  30  10
"

# ------------------------------------------------------------
# NOAA-GFS URL format
# ------------------------------------------------------------
# https://nomads.ncep.noaa.gov/cgi-bin/filter_gfs_0p25.pl?dir=%2Fgfs.20260907%2F00%2Fatmos&file=gfs.t00z.pgrb2.0p25.anl&var_APCP=on&var_GUST=on&var_PRATE=on&var_PRES=on&var_TMP=on&var_UGRD=on&var_VGRD=on&lev_10_m_above_ground=on&lev_surface=on&subregion=&toplat=46&leftlon=11&rightlon=18&bottomlat=42

# URL-encode a string
urlenc() { echo -n "$*" | perl -pe "s/([^A-Za-z0-9^\-_.!~*'])/sprintf '%%%0x', ord \$1/eg"; }
BASE_URL="https://nomads.ncep.noaa.gov/cgi-bin/filter_gfs_0p25.pl?"
# dir=%2Fgfs.${DATE}%2F${CYCLE}%2Fatmos" "/gfs.${DATE}/${CYCLE}/atmos"
add_param() { local u="$1" v=`urlenc "$2"` w=`urlenc "$3"` s=
              [ "$u" = "${u%%?}" ] || s="&"
              echo -n "$u$s$v=$w"; }
add_var() { add_param "$1" "var_$2" "${3:-on}"; }
add_lev() { add_param "$1" "lev_$2" "${3:-on}"; }
add_item() { plexit "'$2' =~ /^[A-Z\d-]+\$/" && add_var "$@" || add_lev "$@"; }

# Available parameters:
PARAMETERS="
