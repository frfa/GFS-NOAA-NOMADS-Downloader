PV=2e-06_(Km^2/kg/s)_surface
"

DATASETS="
None 
Sailing APCP GUST PRATE PRES TMP UGRD VGRD surface 10_m_above_ground
Extended TMP 2_m_above_ground DPT 2_m_above_ground RH 2_m_above_ground TCDC entire_atmosphere PRATE surface CSNOW surface UGRD 10_m_above_ground VGRD 10_m_above_ground GUST surface CAPE surface CFRZR surface SNOD surface WEASD surface HGT 925_mb 850_mb 700_mb 600_mb 500_mb 400_mb 300_mb 250_mb 200_mb TMP 925_mb 850_mb 700_mb 600_mb 500_mb 400_mb 300_mb 250_mb 200_mb HGT 0C_isotherm RH 0C_isotherm PRES 0C_isotherm
"
# Default dataset
DATASET="Sailing"

# ------------------------------------------------------------
# DIRECTORIES
# ------------------------------------------------------------

# Temporary working files
WORKDIR="/tmp/gfs-v9-${DATE}-${CYCLE}z"
WORKTMP="/tmp/gfs-$DATE.XXXXXX"

# Official GRIB directory of XyGrib
XYGRIB_DIR="${HOME}/.xygrib/grib"

# Final file
OUTPUT="${XYGRIB_DIR}/GFS_NOAA_${DATE}_${CYCLE}Z_72hs.grib2"

# Pause between requests
PAUSE=4

# Expected number of files
EXPECTED_FILES=25


######################################################################
#
# Command line parsing and help
#
######################################################################

usage() {
cat <<EOF
Usage: $program [-options] {parameters-and-levels}

Description:
$program downloads individual weather forecasts from the NOAA-GFS website
for a certain forecast period and stitches those individual files together to
form a GRIB2-compliant result file that can be displayed in XyGrib.

Options are:
-v, --verbose	verbose mode
-q, --quiet	quiet mode
-d, --debug	debug mode
-n, --noexec	do not actually execute anything, just simulate
-h, --help	this help text
-p, --pause N   pause N seconds between requests (default: $PAUSE seconds)
-c, --cycle NN  use GFS run cycle NN (may be 00, 06, 12, or 18, default: $CYCLE)
-f, --forecast  NN download NN-hour forecast (multiples of 3, default $MAX_FORECAST)
-r, --region S  Download forecast for pre-defined region S
-lr, --list-regions	List available regions
-s, --dataset S Use GRIB parameters in dataset S when downloading from NOAA-GFS
                (default: $DATASET)
-ls, --list-datasets	List available datasets
-lp, --list-parameters	List available parameters
-ll, --list-levels	List available levelrs
EOF
   exit 1
}

# options & args
while :; do
    case "$1" in
        -d|--debug) d=-d v=-v q=;;
        -dd|--moredebug) d=-d v=-v q=; set -xv;;
        -v|--verbose) v=-v q=;;
        -q|--quiet) q=-q v=;;
        -n|--noexec) n=-n;;
	/\?|-h|--help) usage;;
        # specific options go here
        -p|--pause) PAUSE="$2"; shift;;
        -c|--cycle) CYCLE="$2"; shift;;
        -f|--forecast) MAX_FORECAST="$2"; shift;;
        -r|--region) REGION="$2"; shift;;
        -lr|--list-regions) list_regions="$1";;
        -s|--dataset) DATASET="$2"; shift;;
        -ls|--list-datasets) list_datasets="$1";;
        -lp|--list-parameters) list_parameters="$1";;
        -ll|--list-levels) list_levels="$1";;
	-*) wrn "Unknown option $1 ignored";;
	*) break;;
    esac
    shift
done
generic_opts="$d $v $q"
#[ $# -lt 1 ] && ftl 'No arguments provided'

# list regions
[ "$list_regions" ] && echo "Defined regions   W   E   N   S$REGIONS" && exit 1

# extract region coordinates
[ "$REGION" ] && {
    rl=`echo "$REGIONS"|egrep "^$REGION\b"`
    [ "$rl" ] || ftl "Could not find region $REGION - use -rl to list regions"
    WEST=`echo $rl|plawk 'print $F[1]'`
    EAST=`echo $rl|plawk 'print $F[2]'`
    NORTH=`echo $rl|plawk 'print $F[3]'`
    SOUTH=`echo $rl|plawk 'print $F[4]'`
    ntc "Using region $REGION: $WEST, $EAST, $NORTH, $SOUTH"
}

# list datasets
[ "$list_datasets" ] && echo "Defined datasets:$DATASETS" && exit 1

# list parameters
[ "$list_parameters" ] && echo "Defined parameters:$PARAMETERS" && exit 1

# list levels
[ "$list_levels" ] && echo "Defined levels:$LEVELS" && exit 1

# ------------------------------------------------------------
# CHECKS & PREPARATION
# ------------------------------------------------------------

# check forecast range
[ "$MAX_FORECAST" -lt 0 -o 384 -lt "$MAX_FORECAST" ] &&\
    ftl "Forecast $MAX_FORECAST out of allowed range 00 - 384"

# construct ITEMS from dataset and command line parameters
ITEMS=`echo "$DATASETS" | grep "^$DATASET" | cut -d" " -f2-`" $*"

# create temp working dir
mkdir -p "${XYGRIB_DIR}"
#mkdir -p "${WORKDIR}"
WORKDIR=`mktemp -d "$WORKTMP"`
trap "rm -rf $WORKDIR" 1 2 3 9 15

cat <<EOF
============================================================
 GFS NOAA NOMADS - V9
 $MAX_FORECAST-hour forecast for XyGrib
============================================================

Date        : ${DATE}
Cycle       : ${CYCLE}Z
Horizon     : f000 → f${MAX_FORECAST}
Interval    : ${STEP} hours
Timesteps   : ${EXPECTED_FILES}

Region:
  West      : ${WEST}
  East      : ${EAST}
  North     : ${NORTH}
  South     : ${SOUTH}

Items:
  $ITEMS

XyGrib directory:
  ${XYGRIB_DIR}

Output:
  ${OUTPUT}

Temporary directory:
  ${WORKDIR}

============================================================
EOF

###
# Build static part of URL (without file= parameter
###

STATIC_URL="$BASE_URL"
STATIC_URL=`add_param "$STATIC_URL" dir "/gfs.${DATE}/${CYCLE}/atmos"`
for i in $ITEMS; do
    STATIC_URL=`add_item "$STATIC_URL" "$i" on`
done
# subregion=&leftlon=${WEST}&rightlon=${EAST}&toplat=${NORTH}&bottomlat=${SOUTH}"
STATIC_URL=`add_param "$STATIC_URL" subregion ""`
STATIC_URL=`add_param "$STATIC_URL" leftlon "$WEST"`
STATIC_URL=`add_param "$STATIC_URL" rightlon "$EAST"`
STATIC_URL=`add_param "$STATIC_URL" toplat "$NORTH"`
STATIC_URL=`add_param "$STATIC_URL" bottomlat "$SOUTH"`
dbg "STATIC_URL now: $STATIC_URL"

# ------------------------------------------------------------
# DOWNLOAD OF EACH TIMESTEP
# ------------------------------------------------------------

HOUR=0
while [ "$HOUR" -le "$MAX_FORECAST" ]; do
    FORECAST=$(printf "%03d" "${HOUR}")
    FILE="gfs.t${CYCLE}z.pgrb2.0p25.f${FORECAST}"
    PART="${WORKDIR}/gfs_${FORECAST}.grib2"
    inf "Forecast: F${FORECAST} file: ${FILE}"

    DNL_URL=`add_param "$STATIC_URL" file "$FILE"`
    dbg "DNL_URL now: $DNL_URL"
    exe curl -f -s -S --location --connect-timeout 30 --max-time 600 \
        --retry 2 --retry-delay 5 --output "${PART}" \
        "$DNL_URL" || ftl "Could not download F$FORECAST"

    [ ! -s "${PART}" ] && ftl "ERROR: F${FORECAST} produced an empty file."

    SIZE=$(du -h "${PART}" | cut -f1)
    ntc "OK → F${FORECAST} (${SIZE})"

    # Do not wait after the last file
    if [ ${HOUR} -lt ${MAX_FORECAST} -a -n "$PAUSE" ]; then
        inf "Waiting ${PAUSE} seconds..."
        exe sleep "${PAUSE}"
    fi

    HOUR=`expr "$HOUR" + "$STEP"`
done

# ------------------------------------------------------------
# VERIFY FILE COUNT
# ------------------------------------------------------------

COUNT=$(find "${WORKDIR}" -maxdepth 1 -name 'gfs_*.grib2' | wc -l)

ntc "Download complete"
inf "Files obtained : ${COUNT}; expected: ${EXPECTED_FILES}"

[ "${COUNT}" -ne "${EXPECTED_FILES}" ] &&\
    ftl "ERROR: Did not obtain the ${EXPECTED_FILES} expected timesteps."

# ------------------------------------------------------------
# BUILD FINAL GRIB2
# ------------------------------------------------------------

ntc "Building $MAX_FORECAST-hour GRIB2..."

rm -f "${OUTPUT}"
#HOUR=0
#while [ "$HOUR" -le "$MAX_FORECAST" ]; do
#    FORECAST=$(printf "%03d" "${HOUR}")
#    PART="${WORKDIR}/gfs_${FORECAST}.grib2"
#    cat "${PART}" >> "${OUTPUT}"
#    HOUR=`expr "$HOUR" + "$STEP"`
#done
cat "${WORKDIR}"/gfs_*.grib2 >"$OUTPUT"

# ------------------------------------------------------------
# FINAL VERIFICATION
# ------------------------------------------------------------

[ ! -s "${OUTPUT}" ] && ftl "ERROR: Could not create the final GRIB2."

inf "Finished; final file: ${OUTPUT}"
ls -lh "${OUTPUT}"

inf "Total size of parts:"
du -ch "${WORKDIR}"/*.grib2 | tail -1

cat <<EOF
The final file is already inside the official
GRIB directory of XyGrib: ${XYGRIB_DIR}
Final file: ${OUTPUT}
EOF
