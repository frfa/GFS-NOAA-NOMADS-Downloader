#!/bin/sh
program=`basename $0`
#program="${0##*/}"
progdir=`dirname $0`
version="v9"
# ============================================================
# GFS NOAA NOMADS - $version
# NN-hour forecast for XyGrib
#
# Base: V8 / V7 VALIDATED
#
# Download:
#   f000 ... f072
#   every 3 hours
#
# Total:
#   25 files
#
# Result:
#   a single GRIB2 with a NN-hour forecast
#
# The final file is saved directly to:
#   ~/.xygrib/grib
#
# This allows XyGrib to find it automatically
# and allows XyGrib's existing cleanup tasks
# to manage older files.
# ============================================================

#set -u

# vars
d= v= q= n=

# funcs
[ -t 2 ] && black='\033[30m' red='\033[31m' green='\033[32m' yellow='\033[33m' blue='\033[34m' magenta='\033[35m' cyan='\033[36m' white='\033[37m' dflt='\033[39m'
#msg() { [ "$q" ] || echo `date +"%Y-%m-%d %T"` $program "$@" >&2; }
#msg() { [ "$q" ] || echo $program "$@" >&2; }
msg() { echo "$@" >&2; } # generic messages are always issued
dbg() { [ "$d" ] && msg ${white}D "$@"$dflt; } # debug messages on -d
dbgx() { [ "$d" ] && { echo -n $white; "$@"; echo -n $dflt;} }
ntc() { [ "$q" ] || msg ${green}N "$@"$dflt; } # notices always except on -q
inf() { [ "$v" ] && msg ${cyan}I "$@"$dflt; } # informationals only on -v
wrn() { [ "$q" ] || msg ${yellow}W "$@"$dflt; } # warnings always except on -q
err() { msg ${red}E "$@"$dflt; } # errors are issued always
syserr() { msg ${red}E "$@: `expl \\\$!=$?`"$dflt; } # system errors as well
ftl() { local s=$?; msg ${red}F "$@ ($?)"$dflt; exit $s; } # fatals exit
sysftl() { local s=$?; msg ${red}F "$@: `expl \\\$!=$?`"$dflt; exit $s; } # system fatals
exe() { [ "$n" ] && msg "$@" || { dbg "$@"; "$@"; }; } # executions except -n
# helpers
expl() { perl -e "print $*"; }
match() { re="$1"; shift; perl -e "'$*' =~ /$re/ && print \$1"; }
filebase() { match '(.*?)(?:\.\w+)?$' "$*"; }
plexit() { perl -e "exit ! ($*)"; }
plawk() { perl -lane "$@"; }
plawki() { perl -i -lane "$@"; }
plsed() { perl -pale "$@"; }
plsedi() { perl -i -pale "$@"; }
# edit configuration: file keyword assignment
confedit () { plsed "$1" "s/^\s*(?:\#\s*)$2.*/$2$3/ && exit 1" || echo "$2$3" >>"$1"; }
uppercase() { expl "\"\U$*\""; }
lowercase() { expl "\"\L$*\""; }
isint() { expr "$1" : '^[+-]\?[0-9]\+$' >/dev/null; }
isnum() { expr "$1" : '^[+-]\?[0-9]\+\.\?[0-9]*[eE]\?[+-]\?[0-9]*$' >/dev/null; }

# ------------------------------------------------------------
# CONFIGURATION
# ------------------------------------------------------------

DATE=$(date -u +%Y%m%d)

# GFS Cycle - 00, 06, 12, 18
CYCLE="00"

# Horizon: 72 hours
MAX_FORECAST=72

# Time interval
STEP=3

# Select Region coordinates:
# Adriatic
WEST="11" EAST="18" NORTH="46" SOUTH="42"

# Pre-defined regions format
# Region-name	West-boundary East-boundary North-boundary South-boundary
REGIONS="
South-America   -80 -50 -15 -58
Adriatic         11  18  46  42
Mediterranean    -5  36  46  30
